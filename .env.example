# ==========================================
# Hadith Lens - Environment Configuration
# ==========================================

# Port on which the application will run (default: 3000)
PORT=3000

# Google Gemini API Key (Required for AI Smart Query Expansion & Multi-Language Live Translation)
# Note: Basic Arabic search and pre-cached English translations work 100% offline without this key!
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name (default: gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-3.5-flash-lite, etc.
GEMINI_MODEL=gemini-2.5-flash

# DeepL API Key (Optional - enables higher quality translations for supported languages)
# Free tier keys end with :fx (e.g., 12345678:fx)
# Paid tier keys do not have :fx suffix
# If not provided, all translations will use Gemini
DEEPL_API_KEY=your_deepl_api_key_here

# Enable/disable DeepL provider (default: false)
DEEPL_ENABLED=false
